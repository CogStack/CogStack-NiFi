# Restricted application accounts. Public development passwords only.
# Bootstrap accounts above are reserved for database initialization/administration.
POSTGRES_INGEST_USER_SAMPLES=cogstack_samples
POSTGRES_INGEST_PASSWORD_SAMPLES=SamplesIngest!1
DATABASE_INGEST_USER=cogstack_ingest
DATABASE_INGEST_PASSWORD=DatabankIngest!1
MSSQL_INGEST_USER=cogstack_ingest
MSSQL_INGEST_PASSWORD=MssqlIngest!1
