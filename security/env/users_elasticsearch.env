######################################################################################################################

# admin account, ELASTIC_USER must always be set to "elastic" if you are using NATIVE ELASTICSEARCH,
# for opensearch it is "admin"
ELASTIC_USER=admin

# admin account password
ELASTIC_PASSWORD=admin
# Read only by the demo installer, which this deployment disables.
# Actual credentials come from internal_users.yml; ELASTIC_PASSWORD must match its admin hash.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Kibanaserver!1

# Public development values, identical on all OpenSearch nodes.
# Replace through deployment-local configuration or an external secret store.
# Keep the salt stable (16 ASCII characters) and preserve the datasource key
# (16, 24, or 32 ASCII characters) to decrypt existing datasource credentials.
OPENSEARCH_COMPLIANCE_SALT=0123456789abcdef
OPENSEARCH_DATASOURCE_MASTER_KEY=0123456789abcdef0123456789abcdef

# specify here the kibana user and password that 
# will be used by kibana when connecting to ES
KIBANA_USER=kibanaserver
KIBANA_PASSWORD=kibanaserver

# used in the account creation script
ELASTIC_HOST=localhost

INGEST_SERVICE_USER=ingest_service
INGEST_SERVICE_PASSWORD=ingest_service

# this email will be associated with all of the above accounts: admin, ingest_service, and kibanaserver
ES_ADMIN_EMAIL="cogstack@admin.net"

# Metricbeat user
METRICBEAT_USER=metricbeat
METRICBEAT_PASSWORD=kibanaserver

# Filebeat user
FILEBEAT_USER=filebeat
FILEBEAT_PASSWORD=kibanaserver

# Build-in ElasticSearch users with passwords
#
# IMPORTANT: please change these for production
#

# the build-in users -- can be set up automatically
# includes: logstash, kibanaro, readall, snapshotrestore
#
ES_LOGSTASH_PASS=kibanaserver
ES_KIBANARO_PASS=kibanaserver
ES_READALL_PASS=kibanaserver
ES_SNAPSHOTRESTORE_PASS=kibanaserver

# Other OpenSearch internal users present in security/es_roles/opensearch/internal_users.yml
ANOMALYADMIN_PASSWORD=anomalyadmin
NEW_USER_PASSWORD=new-user
