pid ${NGINX_RUNTIME_DIR}/nginx.pid;
worker_processes ${NGINX_WORKER_PROCESSES};
error_log /dev/stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    server_name_in_redirect off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 8192;
    client_body_temp_path ${NGINX_RUNTIME_DIR}/client_temp;
    proxy_temp_path ${NGINX_RUNTIME_DIR}/proxy_temp;
    fastcgi_temp_path ${NGINX_RUNTIME_DIR}/fastcgi_temp;
    uwsgi_temp_path ${NGINX_RUNTIME_DIR}/uwsgi_temp;
    scgi_temp_path ${NGINX_RUNTIME_DIR}/scgi_temp;

    resolver ${NGINX_DNS_RESOLVER} valid=10s;
    resolver_timeout 3s;
    upstream nifi {
        zone nifi 64k;
        server ${NIFI_UPSTREAM_HOST}:${NIFI_UPSTREAM_PORT} resolve;
    }

    proxy_ssl_server_name on;
    proxy_ssl_name ${NIFI_UPSTREAM_TLS_NAME};
    proxy_ssl_trusted_certificate "${NGINX_UPSTREAM_CA}";
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/sites-enabled/*.conf;

    # Local liveness does not depend on NiFi or any external service.
    server {
        listen 127.0.0.1:${NGINX_HEALTH_PORT};
        access_log off;
        location = /healthz/live {
            default_type text/plain;
            return 200 'ok\n';
        }
        location = /healthz/ready {
            proxy_set_header Host ${NIFI_UPSTREAM_TLS_NAME};
            proxy_connect_timeout 3s;
            proxy_read_timeout 3s;
            proxy_pass https://nifi/nifi-api/authentication/configuration;
        }
    }

    server {
        listen ${NIFI_INTERNAL_PORT_NGINX} ssl;
        server_name ${NGINX_NIFI_SERVER_NAME};
        ssl_certificate "${NGINX_TLS_CERTIFICATE}";
        ssl_certificate_key "${NGINX_TLS_CERTIFICATE_KEY}";
        ssl_protocols TLSv1.2 TLSv1.3;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-ProxyHost $host;
        proxy_set_header X-ProxyPort ${NIFI_WEB_PROXY_PORT};
        proxy_set_header X-ProxyScheme ${NGINX_PROXY_SCHEME};
        proxy_set_header X-ProxyContextPath "${NGINX_PROXY_CONTEXT_PATH}";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${NGINX_PROXY_SCHEME};

        location ${NGINX_PROXY_CONTEXT_PATH}/ {
            proxy_pass https://nifi/;
        }
        location ${NGINX_PROXY_CONTEXT_PATH}/nifi-api/ {
            proxy_hide_header X-Frame-Options;
            proxy_pass https://nifi/nifi-api/;
        }
    }
}
