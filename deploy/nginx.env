# Published nginx proxy image, pinned to its multi-platform registry manifest.
NIFI_NGINX_DOCKER_IMAGE=cogstacksystems/nifi-nginx@sha256:486c933b05e14b4a3a1e4f966d832b27b2097f6789d8c9fbeb0c129d97a7136f

NGINX_KIBANA_HOST=kibana
NGINX_KIBANA_PROXY_PORT=5601
NGINX_ES_NODE_SOURCE_INSTANCE_NAME="elasticsearch-1"

NGINX_NIFI_SERVER_NAME=_

NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx


NGINX_SHM_SIZE=512mb
NGINX_DOCKER_CPU_MIN=1
NGINX_DOCKER_CPU_MAX=1
NGINX_DOCKER_RAM=1g
