POSTGRES_DB_MAX_CONNECTIONS=100
POSTGRES_SAMPLES_DB_NAME=db_samples
# Paths are relative to deploy/, or may be absolute for supplied certificate bundles.
POSTGRES_SAMPLES_TLS_DIR="${POSTGRES_SAMPLES_TLS_DIR:-../security/certificates/postgresql/samples}"
POSTGRES_DATABANK_TLS_DIR="${POSTGRES_DATABANK_TLS_DIR:-../security/certificates/postgresql/databank}"
POSTGRES_SAMPLES_JDBC_URL="jdbc:postgresql://samples-db:5432/${POSTGRES_SAMPLES_DB_NAME}?sslmode=verify-full&sslrootcert=/run/database-cas/samples-ca.crt"

# Host access defaults to loopback; containers continue to use service DNS.
POSTGRES_SAMPLES_OUTPUT_HOST=127.0.0.1
POSTGRES_SAMPLES_OUTPUT_PORT=5554
POSTGRES_DATABANK_OUTPUT_HOST=127.0.0.1
POSTGRES_DATABANK_OUTPUT_PORT=5558
MSSQL_OUTPUT_HOST=127.0.0.1
MSSQL_OUTPUT_PORT=1433

# Local SQL Server uses a self-signed certificate. Set false with a trusted CA
# installed in the initializer image for certificate/hostname verification.
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_TLS_HOSTNAME=""

# Prefix of file names to load the DB schema for in /services/cogstack-db/(pgsql/mssql)/schemas/ folder
POSTGRES_DB_SCHEMA_PREFIX="cogstack_db"

# production db name
DATABASE_DB_NAME=cogstack

DATABASE_DOCKER_SHM_SIZE=1g

DATABASE_DOCKER_CPU_MIN=1
DATABASE_DOCKER_CPU_MAX=1
DATABASE_DOCKER_RAM=2g

# ClickHouse analytics/ingestion database. These credentials are suitable for
# local development only and must be overridden in shared or production use.
CLICKHOUSE_DOCKER_IMAGE=clickhouse/clickhouse-server:26.8@sha256:d426d2f612e1e189c90f9a3f8dcd85a03c6851273833817a296bb327e63aa7a7
CLICKHOUSE_DB=cogstack
CLICKHOUSE_USER=cogstack
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# Other containers connect to clickhouse:8123 (HTTP) or clickhouse:9000
# (native protocol) on cogstack-net. These values control host access only.
CLICKHOUSE_OUTPUT_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

CLICKHOUSE_DOCKER_CPU_MIN=0.5
CLICKHOUSE_DOCKER_CPU_MAX=2
CLICKHOUSE_DOCKER_RAM_MIN=512m
CLICKHOUSE_DOCKER_RAM=2g
