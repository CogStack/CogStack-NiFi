####################################################################### SGLang Env vars #######################################################################

# OpenSearch AI backend: ollama (default) or sglang. The explicit Make target
# `make opensearch-ai-init-sglang` selects SGLang for that run too.
OPENSEARCH_AI_PROVIDER=${OPENSEARCH_AI_PROVIDER:-sglang}

# URL as seen from the OpenSearch containers, including /v1. For a server on
# this Docker host use host.docker.internal, not localhost. For another machine
# use its reachable hostname/IP. SGLang must listen on an accessible interface.
SGLANG_BASE_URL=${SGLANG_BASE_URL:-http://host.docker.internal:30000/v1}

# Exact served model ID from GET /v1/models (or SGLang's --served-model-name).
# Leave empty to discover it automatically when the server exposes one model.
SGLANG_MODEL=${SGLANG_MODEL:-"mlx-community/Qwen3.8-27B-4bit"}

# Optional: match the server's --api-key. Empty means no Authorization header.
# Prefer exporting the key in your shell instead of saving it in this file.
SGLANG_API_KEY=${SGLANG_API_KEY:-}
