# Editor files, Python environments, and build caches
.DS_Store
.idea/
.vscode/
.venv/
venv/
__pycache__/
*.py[cod]
.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/
build/
*.egg-info

# Generated keys, certificates, and certificate-tool downloads
*.pem
*.key
*.jks
*.csr
*.srl
*.crt
*.p12
*elasticsearch-ssl-http.zip
*es_native_certs_bundle_pem.zip
*es_native_certs_bundle.zip

/security/certificates/*
!/security/certificates/README.md
/security/scripts/nifi_toolkit/

# Local configuration stays ignored; public templates can be committed.
*.env
.env.*
!*.env.template
/deploy/local/
/security/env/*
!/security/env/README.md
!/security/env/*.env.template

# Checked-in deployment defaults contain public development settings.
!/deploy/database.env
!/deploy/elasticsearch.env
!/deploy/general.env
!/deploy/gitea.env
!/deploy/network_settings.env
!/deploy/nginx.env
!/deploy/nifi.env
!/deploy/ollama.env
!/deploy/openwebui.env
!/deploy/project.env
!/deploy/sglang.env
!/deploy/telemetry.env
!/security/env/certificates_elasticsearch.env
!/security/env/certificates_general.env
!/security/env/certificates_nifi.env
!/security/env/users_database.env
!/security/env/users_elasticsearch.env
!/security/env/users_nginx.env
!/security/env/users_nifi.env

# Documentation output
/docs/build/
/site/
