# IDE envs and system folders
.DS_Store
**/.DS_Store
.idea
.vscode
.venv
.ruff_cache
.mypy_cache
venv
**__pycache__
**/venv
*.pyc 
.pyc
build

# Ignore setuptools metadata
*.egg-info/
*.egg-info
**/*.egg-info/

# Private keys and generated certificates
*.pem
*.key
*.jks
*.csr
*.srl
*.crt
*.p12

*elasticsearch-ssl-http.zip
*es_native_certs_bundle_pem.zip
*es_native_certs_bundle.zip

# Environment files may contain passwords or local paths. Track templates only.
*.env
!*.env.template
!**/*.env.template

# These files remain version-controlled public development defaults because
# the standalone Compose stack and legacy charts consume them directly.
!security/env/
!security/env/*.env

# Certificate contents are generated locally. Keep only their documentation.
security/certificates/*
!security/certificates/README.md

security/scripts/nifi_toolkit/

# docs
docs/build/*
